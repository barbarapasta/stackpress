{
  "extends": "@stackpress/lib/tsconfig/esm",
  "compilerOptions": {
    "moduleResolution": "node",
    "outDir": "esm/",
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "esm",
    "cjs",
    "assets.d.ts",
    "node_modules",
    "tests"
  ]
}
